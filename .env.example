# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# PUBLIC_APP_URL="https://your-public-cloud-run-url.run.app"

# Optional overrides matching swaps/environment settings from civic_digest.py:
# GEMINI_MODEL="gemini-4-hydrogen"
# CHANNEL_ID="UCB4NM4epfvYv65PPm4qsaiw"
# PLAN_CHAR_BUDGET="200000"
# TRANSCRIPT_CHAR_CAP="150000"
# DOC_CHAR_CAP="40000"
# HISTORY_LOOKBACK_DAYS="365"
# HISTORY_RECENT_WEEKS="4"
# HISTORY_CHAR_BUDGET="180000"
# HISTORY_VOTES_CHAR_CAP="20000"
# LIVE_ONLY="1"
# INCLUDE_PDFS="0"
# SKIP_YT_FETCH="0"
# SKIP_TITLE_REGEX="varsity|\\bJV\\b|junior varsity|football|soccer|hockey|basketball|baseball|softball|volleyball|lacrosse|swim|\\btrack\\b|cross country|MIAA|wrestling|graduation|commencement"

# Free Email Delivery (configure via Settings > Secrets; choose SMTP, Brevo, or Resend):
# EMAIL_TO="you@example.com"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-gmail-app-password"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# BREVO_API_KEY="your-brevo-api-key"
# RESEND_API_KEY="your-resend-api-key"
# EMAIL_FROM="you@example.com"
# CRON_SECRET="optional-secret-for-external-friday-cron"
